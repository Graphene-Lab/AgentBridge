{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AgentBridge (Debug ports)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/agent.exe",
      "args": [
        "--Urls", "http://localhost:5291",
        "--Sip:ListenPort", "6071"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
